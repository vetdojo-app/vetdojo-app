# Copy this file to /srv/vetdojo/web_app/.env on the server. Never commit the
# completed .env file or paste its secrets into chat, tickets, or logs.
DJANGO_SECRET_KEY=replace-with-a-new-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.vetdojo.com
CSRF_TRUSTED_ORIGINS=https://app.vetdojo.com

USE_SQLITE=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DB_CONN_MAX_AGE=60

OPENAI_API_KEY=replace-with-a-new-openai-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_PDF_MODEL=gpt-4.1-mini
OPENAI_PDF_ANALYSIS_ENABLED=true
AI_PROMPT_VERSION=v2
AI_CACHE_TTL_DAYS=30

PRIVATE_MEDIA_ROOT=/srv/vetdojo/private_media
JOURNAL_PDF_MAX_BYTES=26214400
JOURNAL_PDF_MAX_PAGES=500
JOURNAL_PDF_MIN_TEXT_CHARS=200

RAG_CANDIDATE_COUNT=30
RAG_LEXICAL_COUNT=40
RAG_PRIMARY_COUNT=5
RAG_CONTEXT_COUNT=10
RAG_MAX_CHUNKS_PER_SOURCE=3
RAG_MIN_SIMILARITY=0.42
RAG_MIN_RELEVANCE=0.48
RAG_MAX_CONTEXT_CHARS=24000
CHUNK_SIZE_TOKENS=900
CHUNK_OVERLAP_TOKENS=120

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
