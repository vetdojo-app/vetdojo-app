DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Set false and provide the existing Supabase PostgreSQL connection for real RAG use.
USE_SQLITE=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

OPENAI_API_KEY=replace-with-your-openai-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_PDF_MODEL=gpt-4.1-mini
OPENAI_PDF_ANALYSIS_ENABLED=true
AI_PROMPT_VERSION=v2
AI_CACHE_TTL_DAYS=30

# Realtime voice proof of concept. Keep disabled until approved test users are set.
VOICE_FEATURE_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe
VOICE_CLIENT_SECRET_TTL_SECONDS=60
VOICE_SESSION_REQUEST_COOLDOWN_SECONDS=5
VOICE_MAX_SESSION_MINUTES=20
VOICE_QUERY_TIMEOUT_SECONDS=120
VOICE_VAD_THRESHOLD=0.55
VOICE_VAD_PREFIX_PADDING_MS=300
VOICE_VAD_SILENCE_DURATION_MS=700
VOICE_TEST_USERS=

# Journal PDFs are stored privately and are never served directly by Nginx.
PRIVATE_MEDIA_ROOT=/srv/vetdojo/private_media
JOURNAL_PDF_MAX_BYTES=26214400
JOURNAL_PDF_MAX_PAGES=500
JOURNAL_PDF_MIN_TEXT_CHARS=200

RAG_CANDIDATE_COUNT=30
RAG_LEXICAL_COUNT=40
RAG_PRIMARY_COUNT=5
RAG_CONTEXT_COUNT=10
RAG_MAX_CHUNKS_PER_SOURCE=3
RAG_MIN_SIMILARITY=0.42
RAG_MIN_RELEVANCE=0.48
RAG_MAX_CONTEXT_CHARS=24000
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CHUNK_SIZE_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
