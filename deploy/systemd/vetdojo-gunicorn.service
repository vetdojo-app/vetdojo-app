[Unit]
Description=VetDojo Gunicorn application
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/srv/vetdojo/web_app
EnvironmentFile=/srv/vetdojo/web_app/.env
RuntimeDirectory=vetdojo
RuntimeDirectoryMode=0755
ExecStart=/srv/vetdojo/web_app/.venv/bin/gunicorn config.wsgi:application --workers 3 --timeout 120 --bind unix:/run/vetdojo/gunicorn.sock --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
